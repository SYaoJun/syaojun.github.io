source "https://rubygems.org"

# 与 GitHub Pages 一致的 Jekyll 版本，兼容较旧的系统 Ruby
gem "jekyll", "~> 3.9"

# 锁定 ffi，兼容 Ruby 2.6（ffi 1.16+ 要求 Ruby >= 3.0）
gem "ffi", "~> 1.15.0"

# Jekyll 3.x 默认用 kramdown 渲染 GFM，此解析器需显式安装
gem "kramdown-parser-gfm", "~> 1.1"

# Ruby 3.0+ 不再内置 webrick，Jekyll 本地预览需要
gem "webrick", "~> 1.8"
